{
    "$schema": "https://mintlify.com/docs.json",
    "theme": "mint",
    "name": "VerifyYou",
    "colors": {
        "primary": "#16A34A",
        "light": "#FFFFFF",
        "dark": "#000000"
    },
    "fonts": {
        "family": "Inter"
    },
    "favicon": "/favicon.svg",
    "logo": {
        "light": "/logo/light.svg",
        "dark": "/logo/dark.svg"
    },
    "navigation": {
        "versions": [
            {
                "version": "v3",
                "default": true,
                "tabs": [
                    {
                        "tab": "Dev",
                        "pages": [
                            {
                                "group": "Integrating",
                                "pages": [
                                    "v3/dev/integrating/start-a-session",
                                    "v3/dev/integrating/placing-your-check",
                                    "v3/dev/integrating/handling-results"
                                ]
                            },
                            {
                                "group": "Server API",
                                "pages": [
                                    "v3/dev/spec/server-api/authentication",
                                    "v3/dev/spec/server-api/initialize",
                                    "v3/dev/spec/server-api/confirmations",
                                    "v3/dev/spec/server-api/lock",
                                    "v3/dev/spec/server-api/lookup",
                                    "v3/dev/spec/server-api/test-confirmation-token",
                                    "v3/dev/spec/server-api/return-url",
                                    "v3/dev/spec/server-api/clients"
                                ]
                            },
                            {
                                "group": "Browser SDK",
                                "pages": [
                                    "v3/dev/spec/browser-sdk/vycheck",
                                    "v3/dev/spec/browser-sdk/vyget",
                                    "v3/dev/spec/browser-sdk/init",
                                    "v3/dev/spec/browser-sdk/vyresult",
                                    "v3/dev/spec/browser-sdk/errors"
                                ]
                            },
                            {
                                "group": "Reference",
                                "pages": [
                                    "v3/faq",
                                    "v3/change-policy",
                                    "v3/changelog"
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "version": "v2",
                "tabs": [
                    {
                        "tab": "Docs",
                        "groups": [
                            {
                                "group": "v2 (legacy)",
                                "pages": [
                                    "v2/quickstart",
                                    "v2/authentication",
                                    "v2/external-ids",
                                    "v2/testing",
                                    "v2/uniqueness-regions"
                                ]
                            }
                        ]
                    },
                    {
                        "tab": "API Reference",
                        "openapi": "v2/openapi.yaml"
                    }
                ]
            },
            {
                "version": "v1",
                "tabs": [
                    {
                        "tab": "Docs",
                        "groups": [
                            {
                                "group": "v1 (legacy)",
                                "pages": [
                                    "v1/index",
                                    "v1/quickstart",
                                    "v1/webhooks"
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "redirects": [
        {
            "source": "/v3/introduction",
            "destination": "/v3/dev/integrating/start-a-session"
        },
        {
            "source": "/v3/concepts/accounts-vs-guests",
            "destination": "/v3/concepts/identity-and-recognition"
        },
        {
            "source": "/v3/concepts/members-vs-guests",
            "destination": "/v3/concepts/identity-and-recognition"
        },
        {
            "source": "/v3/api/initialize",
            "destination": "/v3/dev/spec/server-api/initialize"
        },
        {
            "source": "/v3/api/confirmations",
            "destination": "/v3/dev/spec/server-api/confirmations"
        },
        {
            "source": "/v3/openapi",
            "destination": "/v3/dev/spec/server-api/authentication"
        },
        {
            "source": "/v3/sdk/init",
            "destination": "/v3/dev/spec/browser-sdk/init"
        },
        {
            "source": "/v3/sdk/vycheck",
            "destination": "/v3/dev/spec/browser-sdk/vycheck"
        },
        {
            "source": "/v3/sdk/vyget",
            "destination": "/v3/dev/spec/browser-sdk/vyget"
        }
    ],
    "navbar": {
        "links": [
            {
                "label": "OpenAPI spec",
                "href": "https://trust.verifyyou.com/openapi.json"
            },
            {
                "label": "Website",
                "href": "https://verifyyou.com/"
            }
        ]
    },
    "contextual": {
        "options": [
            "copy"
        ]
    },
    "footer": {
        "socials": {
            "linkedin": "https://www.linkedin.com/search/results/all/?keywords=verifyyou&origin=RICH_QUERY_SUGGESTION&heroEntityKey=urn%3Ali%3Aorganization%3A105571405&position=0"
        }
    }
